# =====================================================================
# KRIVA — environment variables (PLACEHOLDERS ONLY — never commit real values)
# Copy to .env.local for local development; set the same names in your
# hosting provider (e.g. Vercel → Project → Settings → Environment Variables).
# =====================================================================

# Public site URL (used for SEO, sitemap and Open Graph links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings → API Keys) ---------------------------
# Public values: safe in the browser, protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# (Older projects: you may use NEXT_PUBLIC_SUPABASE_ANON_KEY instead.)

# SERVER-ONLY secret key — bypasses RLS. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx
# (Older projects: SUPABASE_SERVICE_ROLE_KEY is also accepted.)

# --- Razorpay (Dashboard → Account & Settings → API Keys) --------------
# PAYMENTS_MODE must match the key type: "test" with rzp_test_ keys, "live" with rzp_live_ keys.
PAYMENTS_MODE=test
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
# SERVER-ONLY secrets:
RAZORPAY_KEY_SECRET=replace_with_key_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_webhook_secret

# --- Optional ---------------------------------------------------------
# Path of the official logo inside /public (default /brand/kriva-logo.png)
# NEXT_PUBLIC_LOGO_PATH=/brand/kriva-logo.png

# Demo only: show the owner dashboard with sample orders and no login.
# Ignored whenever Supabase is configured. NEVER set this in production.
# KRIVA_DEMO_ADMIN=1
